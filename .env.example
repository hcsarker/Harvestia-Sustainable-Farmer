# Web Environment Variables (Vite)
# Rename to .env and fill with real values. NEVER commit real secrets.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional alternative if you know your Supabase Project ID (domain will be https://<ID>.supabase.co)
# VITE_SUPABASE_PROJECT_ID=
# VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: Feature flags
VITE_FEATURE_SIMULATION_ADVANCED=false
VITE_LOG_LEVEL=info
