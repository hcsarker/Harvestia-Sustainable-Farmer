# Either set VITE_SUPABASE_URL or VITE_SUPABASE_PROJECT_ID
VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=bnyagvqylorlastljrey

# Public key (anon/publishable)
VITE_SUPABASE_ANON_KEY=
# or
VITE_SUPABASE_PUBLISHABLE_KEY=

# Admin allow-list (comma-separated, lowercased)
VITE_ADMIN_EMAILS=hridoy.pstu.cse19@gmail.com

# Optional: adjust UI or features here as needed
# Web (Vite) – required
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional alias for ANON (some setups expose PUBLISHABLE instead)
VITE_SUPABASE_PUBLISHABLE_KEY=

# Frontend-only admin allow-list (comma-separated emails)
# Controls UI access to /admin/quizzes, server still enforces ADMIN_EMAILS
VITE_ADMIN_EMAILS=
# Web Environment Variables (Vite)
# Rename to .env and fill with real values. NEVER commit real secrets.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional alternative if you know your Supabase Project ID (domain will be https://<ID>.supabase.co)
# VITE_SUPABASE_PROJECT_ID=
# VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: Feature flags
VITE_FEATURE_SIMULATION_ADVANCED=false
VITE_LOG_LEVEL=info
